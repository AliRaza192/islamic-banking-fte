GEMINI_API_KEY=your_gemini_api_key_here
DATABASE_URL=your_neon_connection_string_here
GEMINI_MODEL=gemini-2.5-flash

# Auth — Generate a strong secret: openssl rand -base64 48
# Minimum 64 characters, random. NEVER use a short/predictable string.
JWT_SECRET=your_random_64_char_secret_here_generate_with_openssl_rand_base64_48

# Email OTP (Resend)
RESEND_API_KEY=re_your_resend_api_key_here

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_PREMIUM=price_your_premium_price_id  # Must be price_* (not prod_*)
STRIPE_PRICE_PROFESSIONAL=price_your_professional_price_id  # Must be price_* (not prod_*)

GOLD_API_KEY=goldapi.io

# Admin Dashboard — Generate a strong password: openssl rand -base64 24
ADMIN_PASSWORD=your_admin_password_here