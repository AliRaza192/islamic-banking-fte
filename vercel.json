{
  "version": 2,
  "outputDirectory": "web",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",          "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection",         "value": "1; mode=block" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy",  "value": "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; connect-src 'self' https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache" }
      ]
    },
    {
      "source": "/(.*\\.js|.*\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/",                      "destination": "/landing.html" },
    { "source": "/landing",               "destination": "/landing.html" },
    { "source": "/chat",                  "destination": "/chat.html" },
    { "source": "/app",                   "destination": "/chat.html" },
    { "source": "/dashboard",             "destination": "/dashboard.html" },
    { "source": "/pricing",               "destination": "/pricing.html" },
    { "source": "/calculators",           "destination": "/calculators.html" },
    { "source": "/banks",                 "destination": "/banks.html" },
    { "source": "/admin",                 "destination": "/admin.html" },
    { "source": "/privacy",               "destination": "/privacy.html" },

    { "source": "/api/chat",              "destination": "/api/chat.js" },
    { "source": "/api/auth/send-otp",     "destination": "/api/auth/send-otp.js" },
    { "source": "/api/auth/verify-otp",   "destination": "/api/auth/verify-otp.js" },
    { "source": "/api/auth/me",           "destination": "/api/auth/me.js" },
    { "source": "/api/auth/logout",       "destination": "/api/auth/me.js?action=logout" },

    { "source": "/api/rates",             "destination": "/api/data.js?action=rates" },
    { "source": "/api/bank-rates",        "destination": "/api/data.js?action=banks" },
    { "source": "/api/compare-banks",     "destination": "/api/data.js?action=compare" },
    { "source": "/api/health",            "destination": "/api/data.js?action=health" },

    { "source": "/api/history",           "destination": "/api/user.js" },
    { "source": "/api/feedback",          "destination": "/api/user.js?action=feedback" },

    { "source": "/api/admin",             "destination": "/api/admin.js" },
    { "source": "/api/admin-rates",       "destination": "/api/admin.js?action=rates" },
    { "source": "/api/admin/cleanup",     "destination": "/api/admin.js?action=cleanup" },

    { "source": "/api/payments/create-checkout", "destination": "/api/payments.js?action=checkout" },
    { "source": "/api/payments/verify",   "destination": "/api/payments.js?action=verify" },
    { "source": "/api/payments/portal",   "destination": "/api/payments.js?action=portal" },
    { "source": "/api/stripe/webhook",    "destination": "/api/payments.js?action=webhook" },
    { "source": "/api/stripe/checkout",   "destination": "/api/payments.js?action=checkout" }
  ]
}
